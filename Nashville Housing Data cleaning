--REMOVING DUPLICATES

SELECT *
FROM NashvilleHousing

WITH NEW_CTE AS (SELECT *, ROW_NUMBER() OVER (PARTITION BY ParcelID,
										PropertyAddress,
										saleDate, 
										saleprice,
										legalreference
								ORDER BY ParcelID) AS ROW_NUM
			 FROM NashvilleHousing)

SELECT *
FROM NEW_CTE
WHERE ROW_NUM > 1

