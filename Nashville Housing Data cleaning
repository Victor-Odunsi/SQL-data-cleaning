/*  
=========================================  
CLEANING DIRTY DATA USING SQL QUERIES  
=========================================  
*/

-- Preview raw data
SELECT *
FROM NashvilleHousing;


---------------------------------------------------------------------
-- STANDARDIZE DATE FORMAT
---------------------------------------------------------------------

-- Check conversion of SaleDate
SELECT 
    SaleDate, 
    CAST(SaleDate AS DATE) AS Corrected_Date, 
    CONVERT(DATE, SaleDate) AS Corrected_Date2
FROM NashvilleHousing;

-- Update SaleDate column
UPDATE NashvilleHousing
SET SaleDate = CAST(SaleDate AS DATE);

-- Add a new column for standardized SaleDate
ALTER TABLE NashvilleHousing
ADD SaleDate2 DATE;

UPDATE NashvilleHousing
SET SaleDate2 = CAST(SaleDate AS DATE);


---------------------------------------------------------------------
-- POPULATE PROPERTY ADDRESS NULL VALUES
---------------------------------------------------------------------

-- Find rows with NULL PropertyAddress
SELECT 
    NA.ParcelID, 
    NA.PropertyAddress AS Property, 
    NB.PropertyAddress AS Property1
FROM NashvilleHousing NA
JOIN NashvilleHousing NB
    ON NA.ParcelID = NB.ParcelID
   AND NA.[UniqueID ] <> NB.[UniqueID ]
WHERE NA.PropertyAddress IS NULL;

-- Update NULL PropertyAddress using self-join
UPDATE NashvilleHousing
SET PropertyAddress = NULL_TABLE.Property1
FROM (
    SELECT 
        NA.ParcelID, 
        NB.PropertyAddress AS Property1
    FROM NashvilleHousing NA
    JOIN NashvilleHousing NB
        ON NA.ParcelID = NB.ParcelID
       AND NA.[UniqueID ] <> NB.[UniqueID ]
    WHERE NA.PropertyAddress IS NULL
) AS NULL_TABLE
WHERE NashvilleHousing.PropertyAddress IS NULL;


---------------------------------------------------------------------
-- SPLIT PROPERTY ADDRESS INTO HOUSE & CITY
---------------------------------------------------------------------

SELECT 
    PropertyAddress,
    LEFT(PropertyAddress, CHARINDEX(',', PropertyAddress) - 1) AS Address,
    RIGHT(PropertyAddress, LEN(PropertyAddress) - CHARINDEX(',', PropertyAddress)) AS City
FROM NashvilleHousing;

-- Add new columns
ALTER TABLE NashvilleHousing
ADD PropertyAddressHouse VARCHAR(200);

ALTER TABLE NashvilleHousing
ADD PropertyAddressCity VARCHAR(200);

-- Populate new columns
UPDATE NashvilleHousing
SET PropertyAddressHouse = LEFT(PropertyAddress, CHARINDEX(',', PropertyAddress) - 1);

UPDATE NashvilleHousing
SET PropertyAddressCity = RIGHT(PropertyAddress, LEN(PropertyAddress) - CHARINDEX(',', PropertyAddress));


---------------------------------------------------------------------
-- SPLIT OWNER ADDRESS INTO HOUSE, CITY, STATE
---------------------------------------------------------------------

SELECT 
    PARSENAME(REPLACE(OwnerAddress, ',', '.'), 3) AS OwnerAddressHouse,
    PARSENAME(REPLACE(OwnerAddress, ',', '.'), 2) AS OwnerAddressCity,
    PARSENAME(REPLACE(OwnerAddress, ',', '.'), 1) AS OwnerAddressState
FROM NashvilleHousing;

-- Add new columns
ALTER TABLE NashvilleHousing
ADD OwnerAddressHouse VARCHAR(200);

ALTER TABLE NashvilleHousing
ADD OwnerAddressCity VARCHAR(200);

ALTER TABLE NashvilleHousing
ADD OwnerAddressState VARCHAR(200);

-- Populate new columns
UPDATE NashvilleHousing
SET OwnerAddressHouse = PARSENAME(REPLACE(OwnerAddress, ',', '.'), 3);

UPDATE NashvilleHousing
SET OwnerAddressCity = PARSENAME(REPLACE(OwnerAddress, ',', '.'), 2);

UPDATE NashvilleHousing
SET OwnerAddressState = PARSENAME(REPLACE(OwnerAddress, ',', '.'), 1);


---------------------------------------------------------------------
-- STANDARDIZE SoldAsVacant RESPONSES
---------------------------------------------------------------------

-- Check distribution
SELECT DISTINCT SoldAsVacant
FROM NashvilleHousing;

-- Apply standardization
UPDATE NashvilleHousing
SET SoldAsVacant = CASE 
                      WHEN SoldAsVacant = 'Y' THEN 'Yes'
                      WHEN SoldAsVacant = 'N' THEN 'No'
                      ELSE SoldAsVacant
                   END;


---------------------------------------------------------------------
-- REMOVE DUPLICATES
---------------------------------------------------------------------

WITH NEW_CTE AS (
    SELECT *,
           ROW_NUMBER() OVER (
                PARTITION BY ParcelID, PropertyAddress, SaleDate, SalePrice, LegalReference
                ORDER BY ParcelID
           ) AS Row_Num
    FROM NashvilleHousing
)
DELETE
FROM NEW_CTE
WHERE Row_Num > 1;


---------------------------------------------------------------------
-- DROP IRRELEVANT COLUMNS
---------------------------------------------------------------------

ALTER TABLE NashvilleHousing
DROP COLUMN TaxDistrict, PropertyAddress, OwnerAddress;

ALTER TABLE NashvilleHousing
DROP COLUMN SaleDate;

