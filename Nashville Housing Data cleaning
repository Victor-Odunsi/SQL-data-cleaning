-- POPULATE PROPERTY ADDRESSES HAVING NULLS

SELECT NA.ParcelID, NA.ParcelID, NA.PropertyAddress PROPERTY, NB.PropertyAddress PROPERTY1
FROM NashvilleHousing NA
JOIN NashvilleHousing NB --Using a self Join here
	ON NA.ParcelID = NB.ParcelID
	AND NA.[UniqueID ]<> NB.[UniqueID ]
	WHERE NA.PropertyAddress IS NULL

SELECT PROPERTY1 
FROM (SELECT NA.ParcelID PARCEL1, NA.ParcelID PARCEL2, NA.PropertyAddress PROPERTY, NB.PropertyAddress PROPERTY1
		FROM NashvilleHousing NA
		JOIN NashvilleHousing NB --Using a self Join here
			ON NA.ParcelID = NB.ParcelID
			AND NA.[UniqueID ] <> NB.[UniqueID ]
		WHERE NA.PropertyAddress IS NULL) NULL_TABLE


UPDATE NashvilleHousing
SET PropertyAddress = PROPERTY1
FROM (SELECT NA.ParcelID PARCEL1, NA.ParcelID PARCEL2, NA.PropertyAddress PROPERTY, NB.PropertyAddress PROPERTY1
		FROM NashvilleHousing NA
		JOIN NashvilleHousing NB --Using a self Join here
			ON NA.ParcelID = NB.ParcelID
			AND NA.[UniqueID ] <> NB.[UniqueID ]
		WHERE NA.PropertyAddress IS NULL) NULL_TABLE
WHERE PropertyAddress IS NULL

